{
  "name": "42tui-activity",
  "displayName": "42TUI Activity",
  "description": "Send local editor activity to 42TUI.",
  "version": "0.1.0",
  "publisher": "42tui",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "42TUI Activity",
      "properties": {
        "42tui.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the 42TUI executable. Leave empty to use the path injected by 42TUI, then auto-detection."
        },
        "42tui.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local editor activity heartbeats."
        }
      }
    }
  }
}
